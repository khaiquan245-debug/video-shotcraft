{
  "cues": [
    {
      "start": 0.35,
      "end": 0.99,
      "text": "Bạn đã bao giờ",
      "first_word": 0,
      "last_word": 3
    },
    {
      "start": 0.99,
      "end": 1.9300000000000002,
      "text": "bước vào một căn phòng,",
      "first_word": 4,
      "last_word": 8
    },
    {
      "start": 1.9300000000000002,
      "end": 3.47,
      "text": "rồi cảm thấy tất cả mọi người",
      "first_word": 9,
      "last_word": 15
    },
    {
      "start": 3.47,
      "end": 4.31,
      "text": "đang nhìn mình chưa?",
      "first_word": 16,
      "last_word": 19
    },
    {
      "start": 4.81,
      "end": 5.569999999999999,
      "text": "Bạn vội chỉnh tóc,",
      "first_word": 20,
      "last_word": 23
    },
    {
      "start": 5.83,
      "end": 6.47,
      "text": "kéo lại áo.",
      "first_word": 24,
      "last_word": 26
    },
    {
      "start": 6.81,
      "end": 8.11,
      "text": "Trong đầu chỉ có một câu hỏi:",
      "first_word": 27,
      "last_word": 33
    },
    {
      "start": 8.11,
      "end": 9.29,
      "text": "Mình trông kỳ lắm sao?",
      "first_word": 34,
      "last_word": 38
    },
    {
      "start": 9.73,
      "end": 10.45,
      "text": "Nhưng sự thật là,",
      "first_word": 39,
      "last_word": 42
    },
    {
      "start": 10.45,
      "end": 11.469999999999999,
      "text": "phần lớn mọi người",
      "first_word": 43,
      "last_word": 46
    },
    {
      "start": 11.469999999999999,
      "end": 12.27,
      "text": "chẳng chú ý đến bạn",
      "first_word": 47,
      "last_word": 51
    },
    {
      "start": 12.27,
      "end": 13.11,
      "text": "nhiều như bạn nghĩ.",
      "first_word": 52,
      "last_word": 55
    },
    {
      "start": 13.469999999999999,
      "end": 14.23,
      "text": "Trong tâm lý học,",
      "first_word": 56,
      "last_word": 59
    },
    {
      "start": 14.57,
      "end": 15.73,
      "text": "hiện tượng này được gọi là",
      "first_word": 60,
      "last_word": 65
    },
    {
      "start": 15.73,
      "end": 16.97,
      "text": "hiệu ứng ánh đèn sân khấu.",
      "first_word": 66,
      "last_word": 71
    },
    {
      "start": 17.25,
      "end": 18.310000000000002,
      "text": "Vì bạn luôn nhìn thế giới",
      "first_word": 72,
      "last_word": 77
    },
    {
      "start": 18.310000000000002,
      "end": 19.23,
      "text": "từ góc nhìn của mình,",
      "first_word": 78,
      "last_word": 82
    },
    {
      "start": 19.41,
      "end": 20.290000000000003,
      "text": "nên bạn dễ tưởng rằng",
      "first_word": 83,
      "last_word": 87
    },
    {
      "start": 20.290000000000003,
      "end": 21.470000000000002,
      "text": "người khác cũng đang để ý",
      "first_word": 88,
      "last_word": 93
    },
    {
      "start": 21.470000000000002,
      "end": 22.33,
      "text": "từng hành động của bạn.",
      "first_word": 94,
      "last_word": 98
    },
    {
      "start": 22.630000000000003,
      "end": 23.73,
      "text": "Nhưng hãy nhìn xung quanh.",
      "first_word": 99,
      "last_word": 103
    },
    {
      "start": 24.21,
      "end": 25.35,
      "text": "Người bên cạnh đang lo lắng",
      "first_word": 104,
      "last_word": 109
    },
    {
      "start": 25.35,
      "end": 26.47,
      "text": "về ngoại hình của chính họ.",
      "first_word": 110,
      "last_word": 115
    },
    {
      "start": 26.89,
      "end": 27.990000000000002,
      "text": "Người phía trước lại đang nhớ",
      "first_word": 116,
      "last_word": 121
    },
    {
      "start": 27.990000000000002,
      "end": 29.330000000000002,
      "text": "về một chuyện xấu hổ hôm qua.",
      "first_word": 122,
      "last_word": 128
    },
    {
      "start": 29.330000000000002,
      "end": 30.39,
      "text": "Ai cũng bận",
      "first_word": 129,
      "last_word": 131
    },
    {
      "start": 30.39,
      "end": 31.33,
      "text": "với những suy nghĩ riêng.",
      "first_word": 132,
      "last_word": 136
    },
    {
      "start": 31.610000000000003,
      "end": 33.25,
      "text": "Vậy nên, lần tới khi bạn sợ",
      "first_word": 137,
      "last_word": 143
    },
    {
      "start": 33.25,
      "end": 34.21,
      "text": "người khác đánh giá mình,",
      "first_word": 144,
      "last_word": 148
    },
    {
      "start": 34.550000000000004,
      "end": 35.33,
      "text": "hãy nhớ điều này.",
      "first_word": 149,
      "last_word": 152
    },
    {
      "start": 35.71,
      "end": 36.35,
      "text": "Bạn là nhân vật chính",
      "first_word": 153,
      "last_word": 157
    },
    {
      "start": 36.35,
      "end": 37.17,
      "text": "trong cuộc đời mình,",
      "first_word": 158,
      "last_word": 161
    },
    {
      "start": 37.47,
      "end": 38.59,
      "text": "nhưng không phải là tâm điểm",
      "first_word": 162,
      "last_word": 167
    },
    {
      "start": 38.59,
      "end": 39.13,
      "text": "trong cuộc đời",
      "first_word": 168,
      "last_word": 170
    },
    {
      "start": 39.13,
      "end": 40.01,
      "text": "của tất cả mọi người.",
      "first_word": 171,
      "last_word": 175
    },
    {
      "start": 40.370000000000005,
      "end": 40.91,
      "text": "Và đôi khi,",
      "first_word": 176,
      "last_word": 178
    },
    {
      "start": 41.230000000000004,
      "end": 41.870000000000005,
      "text": "nhận ra điều đó",
      "first_word": 179,
      "last_word": 182
    },
    {
      "start": 41.870000000000005,
      "end": 42.39,
      "text": "chính là cách",
      "first_word": 183,
      "last_word": 185
    },
    {
      "start": 42.39,
      "end": 43.410000000000004,
      "text": "để bạn tự tin hơn.",
      "first_word": 186,
      "last_word": 190
    }
  ],
