  "captionCues": [
    {
      "start": 0.0,
      "end": 0.7895736619856192,
      "text": "Mỗi khi có người nói"
    },
    {
      "start": 0.7895736619856192,
      "end": 1.5791473239712384,
      "text": "dối anh chàng này, tài"
    },
    {
      "start": 1.5791473239712384,
      "end": 2.3687209859568576,
      "text": "khoản của cậu sẽ lập"
    },
    {
      "start": 2.3687209859568576,
      "end": 3.1582946479424767,
      "text": "tức tăng thêm một trăm"
    },
    {
      "start": 3.1582946479424767,
      "end": 3.4741241127367246,
      "text": "nghìn đồng."
    },
    {
      "start": 3.5442762884466155,
      "end": 4.391250137636611,
      "text": "Để kiểm tra, cậu mượn"
    },
    {
      "start": 4.391250137636611,
      "end": 5.238223986826607,
      "text": "bạn thân năm trăm nghìn."
    },
    {
      "start": 5.308376162536498,
      "end": 6.107778067573224,
      "text": "Người bạn lập tức nói"
    },
    {
      "start": 6.107778067573224,
      "end": 6.58741921059526,
      "text": "mình hết tiền."
    },
    {
      "start": 6.899206658194775,
      "end": 7.711387698634415,
      "text": "Một trăm nghìn đồng xuất"
    },
    {
      "start": 7.711387698634415,
      "end": 8.361132530986128,
      "text": "hiện trong tài khoản."
    },
    {
      "start": 8.431284706696017,
      "end": 9.165406114891596,
      "text": "Cậu lập tức nảy ra"
    },
    {
      "start": 9.165406114891596,
      "end": 9.605878959808942,
      "text": "một ý tưởng."
    },
    {
      "start": 9.676031135518834,
      "end": 10.529032580109154,
      "text": "Cậu mở một dịch vụ"
    },
    {
      "start": 10.529032580109154,
      "end": 11.382034024699477,
      "text": "phỏng vấn đường phố, liên"
    },
    {
      "start": 11.382034024699477,
      "end": 12.235035469289798,
      "text": "tục đặt những câu hỏi"
    },
    {
      "start": 12.235035469289798,
      "end": 13.08803691388012,
      "text": "khó trả lời cho hàng"
    },
    {
      "start": 13.08803691388012,
      "end": 13.429237491716249,
      "text": "trăm người."
    },
    {
      "start": 13.49938966742614,
      "end": 14.342538088780634,
      "text": "Tiền cứ thế chảy vào"
    },
    {
      "start": 14.342538088780634,
      "end": 14.679797457322431,
      "text": "tài khoản."
    },
    {
      "start": 14.74994963303232,
      "end": 15.580868593861549,
      "text": "Chẳng bao lâu, cậu mua"
    },
    {
      "start": 15.580868593861549,
      "end": 16.411787554690775,
      "text": "được ô tô, biệt thự"
    },
    {
      "start": 16.411787554690775,
      "end": 17.242706515520005,
      "text": "và trở thành tỷ phú."
    },
    {
      "start": 17.3128586912299,
      "end": 18.066771294829742,
      "text": "Nhưng khi giàu có, những"
    },
    {
      "start": 18.066771294829742,
      "end": 18.820683898429586,
      "text": "điều kỳ lạ bắt đầu"
    },
    {
      "start": 18.820683898429586,
      "end": 19.12224893986952,
      "text": "xảy ra."
    },
    {
      "start": 19.192401115579415,
      "end": 20.004391881692868,
      "text": "Bạn thân khẳng định chơi"
    },
    {
      "start": 20.004391881692868,
      "end": 20.816382647806325,
      "text": "với cậu không phải vì"
    },
    {
      "start": 20.816382647806325,
      "end": 20.978780801029014,
      "text": "tiền."
    },
    {
      "start": 21.2438001314886,
      "end": 22.106520329377677,
      "text": "Bạn gái nói sẽ yêu"
    },
    {
      "start": 22.106520329377677,
      "end": 22.969240527266752,
      "text": "cậu ngay cả khi cậu"
    },
    {
      "start": 22.969240527266752,
      "end": 23.314328606422382,
      "text": "trắng tay."
    },
    {
      "start": 23.57934793688197,
      "end": 24.461243604096065,
      "text": "Trong bữa tiệc sinh nhật,"
    },
    {
      "start": 24.461243604096065,
      "end": 25.343139271310164,
      "text": "cậu thử thông báo rằng"
    },
    {
      "start": 25.343139271310164,
      "end": 26.04865580508144,
      "text": "mình vừa phá sản."
    },
    {
      "start": 26.118807980791335,
      "end": 26.900331448953988,
      "text": "Mọi người đồng loạt an"
    },
    {
      "start": 26.900331448953988,
      "end": 27.68185491711664,
      "text": "ủi và hứa sẽ không"
    },
    {
      "start": 27.68185491711664,
      "end": 28.150768998014236,
      "text": "bỏ rơi cậu."
    },
    {
      "start": 28.220921173724133,
      "end": 29.069060166110233,
      "text": "Điện thoại lập tức rung"
    },
    {
      "start": 29.069060166110233,
      "end": 29.577943561541893,
      "text": "lên liên tục."
    },
    {
      "start": 29.850757578191473,
      "end": 30.79873632011163,
      "text": "Cậu tắt điện thoại, bỏ"
    },
    {
      "start": 30.79873632011163,
      "end": 31.74671506203179,
      "text": "lại tất cả rồi trở"
    },
    {
      "start": 31.74671506203179,
      "end": 32.315502307183884,
      "text": "về nhà mẹ."
    },
    {
      "start": 32.38565448289378,
      "end": 33.24838009375937,
      "text": "Vừa nhìn thấy con, mẹ"
    },
    {
      "start": 33.24838009375937,
      "end": 34.11110570462497,
      "text": "đã chạy vào bếp chuẩn"
    },
    {
      "start": 34.11110570462497,
      "end": 34.973831315490564,
      "text": "bị một bàn thức ăn."
    },
    {
      "start": 35.04398349120046,
      "end": 35.83896028793141,
      "text": "Cậu hỏi mẹ có thất"
    },
    {
      "start": 35.83896028793141,
      "end": 36.633937084662364,
      "text": "vọng nếu con chẳng còn"
    },
    {
      "start": 36.633937084662364,
      "end": 37.110923162700935,
      "text": "đồng nào không."
    },
    {
      "start": 37.18107533841083,
      "end": 37.90895287818963,
      "text": "Mẹ lắc đầu."
    },
    {
      "start": 38.04925722960942,
      "end": 38.80383156958893,
      "text": "Điện thoại im lặng."
    },
    {
      "start": 39.11561901718844,
      "end": 40.08152336777199,
      "text": "Nhưng khi cậu hỏi mẹ"
    },
    {
      "start": 40.08152336777199,
      "end": 41.047427718355536,
      "text": "đã ăn tối chưa, bà"
    },
    {
      "start": 41.047427718355536,
      "end": 42.013332068939086,
      "text": "mỉm cười: Mẹ ăn rồi,"
    },
    {
      "start": 42.013332068939086,
      "end": 42.78605554940592,
      "text": "con cứ ăn đi."
    },
    {
      "start": 42.856207725115816,
      "end": 43.427558222841924,
      "text": "Cậu mở tủ lạnh."
    },
    {
      "start": 43.856265963291264,
      "end": 44.70478251078969,
      "text": "Bên trong chẳng còn gì."
    },
    {
      "start": 44.774934686499584,
      "end": 45.67854992200349,
      "text": "Hóa ra, trong lúc cậu"
    },
    {
      "start": 45.67854992200349,
      "end": 46.5821651575074,
      "text": "bận kiếm hàng tỷ đồng"
    },
    {
      "start": 46.5821651575074,
      "end": 47.485780393011304,
      "text": "từ những lời nói dối"
    },
    {
      "start": 47.485780393011304,
      "end": 48.02794953431365,
      "text": "của người khác..."
    },
    {
      "start": 48.35532635429314,
      "end": 49.170701744851414,
      "text": "Mẹ vẫn nói dối để"
    },
    {
      "start": 49.170701744851414,
      "end": 49.98607713540969,
      "text": "nhường cho cậu phần thức"
    },
    {
      "start": 49.98607713540969,
      "end": 50.475302369744654,
      "text": "ăn cuối cùng."
    }
