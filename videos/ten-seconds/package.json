{
  "name": "ten-seconds-film",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "node tools/render-smooth.mjs",
    "render:single": "remotion render src/index.ts TenSeconds out/ten-seconds-smooth.mp4 --browser-executable=/usr/bin/chromium --concurrency=4",
    "render:no-music": "remotion render src/index.ts TenSeconds out/ten-seconds-smooth-no-music.mp4 --browser-executable=/usr/bin/chromium --concurrency=4 --props=props-no-music.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.484",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.484"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
